DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/performa_db"
SECRET_KEY="temporary-secret-key-change-in-production"
GEMINI_API_KEY="your-gemini-api-key"
VITE_API_URL="http://localhost:8000"

# Outbound email for account provisioning (password delivery).
# Provider is auto-detected from whichever credential is set, or forced with
# EMAIL_PROVIDER ("sendgrid" | "resend" | "smtp" | "log"). With none set the
# credentials email is logged, not sent. The HTTP APIs use port 443, so they are
# not blocked the way SMTP often is on managed hosts.
EMAIL_PROVIDER=""
EMAIL_FROM=""            # verified sender, e.g. "Performa <no-reply@yourdomain>"
APP_BASE_URL="http://localhost:5173"   # used for the sign-in link in the email
SENDGRID_API_KEY=""
RESEND_API_KEY=""

# SMTP delivery (alternative to the APIs above).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_STARTTLS="true"
SMTP_SSL="false"
